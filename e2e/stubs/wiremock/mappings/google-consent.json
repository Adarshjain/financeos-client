{
  "mappings": [
    {
      "name": "google-consent-screen",
      "priority": 5,
      "request": {
        "method": "GET",
        "urlPath": "/google/o/oauth2/v2/auth"
      },
      "response": {
        "status": 302,
        "headers": {
          "Location": "{{request.query.redirect_uri}}?code=e2e-code-{{request.query.state}}&state={{request.query.state}}"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "google-revoke-catch-all",
      "priority": 10,
      "request": {
        "method": "POST",
        "urlPath": "/google/oauth2/revoke"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {}
      }
    }
  ]
}
