# Public client-side telemetry credentials (browser-facing)
NEXT_PUBLIC_FARO_URL="https://faro-collector-prod-us-east-0.grafana.net/collect/..."
NEXT_PUBLIC_FARO_APP_KEY="faro_app_key_..."

# Server-only telemetry credentials (Vercel Node.js runtime to Loki)
# DO NOT prefix these with NEXT_PUBLIC_ (shipped in browser bundle if prefixed)
GRAFANA_LOKI_URL="https://logs-prod-006.grafana.net/loki/api/v1/push"
GRAFANA_LOKI_USER="123456"
GRAFANA_CLOUD_TOKEN="glc_..."

# Application configuration
LOG_LEVEL="info"
